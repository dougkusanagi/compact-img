{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compact Img",
  "version": "0.1.0",
  "identifier": "com.douglaskusanagi.compactimg",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Compact Img",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#ffffff",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Compactacao local de imagens em lote.",
    "longDescription": "Compacta imagens em lote localmente, sem enviar arquivos para servidores.",
    "copyright": "Copyright (c) 2026 Douglas Kusanagi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
